+def _chat_de(update: dict) -> int:
+    """Chat del que viene un update (mensaje o boton). 0 si no se sabe."""
+
+    if "callback_query" in update:
+        chat = ((update["callback_query"].get("message") or {}).get("chat") or {})
+    else:
+        chat = ((update.get("message") or {}).get("chat") or {})
+
+    try:
+        return int(chat.get("id") or 0)
+    except (TypeError, ValueError):
+        return 0
+
+
+def _autorizado(estado: dict, chat_id: int, texto: str) -> bool:
+    """N01 (H01): solo el chat de Damian manda.
+
+    El chat bueno es canal.chat_id de config.toml si esta puesto; si no, el que
+    aprendio el primer /start. Sin ninguno de los dos, solo se acepta /start
+    (primer arranque). Todo lo demas se ignora sin contestar: ni /start de otro
+    chat cambia el canal, ni /ahora, /orden, /seguir, /hecha o un boton de otro
+    chat hacen nada.
+    """
+
+    fijo = int(valor("canal.chat_id", 0) or 0)
+    esperado = fijo or int(estado.get("chat_id") or 0)
+
+    ok = (chat_id == esperado) if esperado else texto.startswith("/start")
+
+    if not ok:
+        log.warning("update de un chat no autorizado (%s): ignorado", chat_id)
+
+    return ok
+
+
