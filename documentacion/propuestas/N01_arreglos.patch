+# -*- coding: utf-8 -*-
+"""Regresiones de los arreglos de la auditoria N01 (T084, 25/09/2026).
+
+Cada test fija un hallazgo ya arreglado (Hxx en documentacion/nube/N01_2026-09-25.md).
+Solo mocks y carpetas temporales: no toca Telegram, Ollama, Chrome, memoria/ ni
+registros/ reales, y no mata ni lanza ningun proceso.
+"""
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+RAIZ = Path(__file__).resolve().parents[1]
+if str(RAIZ) not in sys.path:
+    sys.path.insert(0, str(RAIZ))
+
+
+# ---------------------------------------------------------------- bot de Telegram (H01, H11)
+
+class _Resp:
+    def __init__(self, datos):
+        self._datos = datos
+
+    def raise_for_status(self):
+        pass
+
+    def json(self):
+        return self._datos
+
+
+class _ClienteFalso:
+    def __init__(self, updates):
+        self.updates = updates
+        self.posts = []
+
+    def get(self, url, params=None, timeout=None):
+        return _Resp({"ok": True, "result": self.updates})
+
+    def post(self, url, json=None, **kw):
+        self.posts.append((url, json))
+        return _Resp({"ok": True})
+
+
+def _update(texto: str, chat_id: int) -> dict:
+    return {"update_id": 1, "message": {"text": texto, "chat": {"id": chat_id}, "from": {"id": chat_id}}}
+
+
+DAMIAN, INTRUSO = 111, 666
+
+
+@pytest.fixture
+def bot(monkeypatch):
+    from canal import bot as b
+    monkeypatch.setattr(b, "guardar_estado", lambda estado: None)
+    monkeypatch.setattr(b, "valor", lambda ruta, defecto=None: defecto)  # sin canal.chat_id fijo
+    return b
+
+
+def test_h01_start_de_un_desconocido_no_cambia_el_chat(bot):
+    estado = {"offset": 0, "chat_id": DAMIAN}
+    cliente = _ClienteFalso([_update("/start", INTRUSO)])
+    bot.procesar_updates(cliente, estado)
+    assert estado["chat_id"] == DAMIAN
+    assert cliente.posts == []  # al desconocido no se le contesta nada
+
+
+def test_h01_ahora_y_seguir_de_un_desconocido_no_hacen_nada(bot, monkeypatch):
+    llamadas = []
+    monkeypatch.setattr(bot, "_cmd_ahora", lambda arg, *a, **k: llamadas.append(("ahora", arg)) or "x")
+    monkeypatch.setattr(bot, "_cmd_seguir", lambda arg: llamadas.append(("seguir", arg)) or "x")
+    estado = {"offset": 0, "chat_id": DAMIAN}
+    bot.procesar_updates(_ClienteFalso([_update("/ahora haz algo", INTRUSO), _update("/seguir", INTRUSO)]), estado)
+    assert llamadas == []
+
+
+def test_h01_damian_sigue_mandando(bot, monkeypatch):
+    llamadas = []
+    monkeypatch.setattr(bot, "_cmd_seguir", lambda arg: llamadas.append(arg) or "ok")
+    estado = {"offset": 0, "chat_id": DAMIAN}
+    bot.procesar_updates(_ClienteFalso([_update("/seguir", DAMIAN)]), estado)
+    assert llamadas == [""]
+
+
+def test_h01_primer_arranque_solo_acepta_start(bot, monkeypatch):
+    llamadas = []
+    monkeypatch.setattr(bot, "_cmd_seguir", lambda arg: llamadas.append(arg) or "ok")
+    estado = {"offset": 0, "chat_id": 0}
+    bot.procesar_updates(_ClienteFalso([_update("/seguir", INTRUSO)]), estado)
+    assert llamadas == [] and estado["chat_id"] == 0
+    bot.procesar_updates(_ClienteFalso([_update("/start", DAMIAN)]), estado)
+    assert estado["chat_id"] == DAMIAN
+
+
+def test_h01_chat_fijo_en_config_manda_sobre_el_aprendido(monkeypatch):
+    from canal import bot as b
+    monkeypatch.setattr(b, "guardar_estado", lambda estado: None)
+    monkeypatch.setattr(b, "valor", lambda ruta, defecto=None: DAMIAN if ruta == "canal.chat_id" else defecto)
+    llamadas = []
+    monkeypatch.setattr(b, "_cmd_seguir", lambda arg: llamadas.append(arg) or "ok")
+    estado = {"offset": 0, "chat_id": INTRUSO}  # estado_bot.json ya secuestrado
+    b.procesar_updates(_ClienteFalso([_update("/seguir", INTRUSO)]), estado)
+    assert llamadas == []  # config manda: el chat aprendido (secuestrado) no vale
+    b.procesar_updates(_ClienteFalso([_update("/start", DAMIAN)]), estado)
+    assert estado["chat_id"] == DAMIAN
+
+
+def test_h11_con_parada_los_mensajes_sueltos_no_usan_modelos(bot, monkeypatch):
+    monkeypatch.setattr(bot, "_parado", lambda: True)
+    usados = []
+    monkeypatch.setattr(bot, "_texto_triaje", lambda t: usados.append("triaje"))
+    monkeypatch.setattr(bot, "_texto_router", lambda t: usados.append("router"))
