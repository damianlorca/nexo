+# ---------------------------------------------------------------- turno sin Claude (H12)
+
+@pytest.fixture
+def turno_aislado(monkeypatch, tmp_path):
+    import turno_nexo
+    from nucleo import parada, trabajo
+
+    (tmp_path / "registros").mkdir()
+    monkeypatch.setattr(turno_nexo, "RAIZ", tmp_path)
+    monkeypatch.setattr(turno_nexo, "ram_libre_gb", lambda: 16.0)
+    monkeypatch.setattr(turno_nexo, "CANDADO", tmp_path / "candado.lock")
+    monkeypatch.setattr(parada, "BANDERA", tmp_path / "PARADA_NEXO")
+    monkeypatch.setattr(parada, "CIERRE", tmp_path / "CIERRE_TURNO")
+    monkeypatch.setattr(trabajo, "handoff", lambda filas, origen="": tmp_path / "handoff.md")
+    return turno_nexo, parada, tmp_path
+
+
+def test_h12_turno_que_rebota_no_borra_el_cierre_del_otro(turno_aislado):
+    turno_nexo, parada, tmp = turno_aislado
+    (tmp / "candado.lock").write_text("1234 0")          # turno A en marcha
+    parada.pedir_cierre("vigilante 04:20: ir acabando")    # aviso para A
+    reg = turno_nexo.turno(simular=True, sin_web=True, avisar=False)  # turno B rebota
+    assert "candado" in reg.get("abortado", "")
+    assert parada.cierre_pedido()
+
+
+def test_h12_el_turno_que_tenia_el_candado_si_limpia_su_cierre(turno_aislado, monkeypatch):
+    turno_nexo, parada, tmp = turno_aislado
+    for paso in ("paso_libres", "paso_etiquetar", "paso_router", "paso_trabajo"):
+        monkeypatch.setattr(turno_nexo, paso, lambda *a, **k: {})
+    parada.pedir_cierre("vigilante 04:20")
+    reg = turno_nexo.turno(simular=True, sin_web=True, avisar=False)
+    assert not reg.get("abortado")
