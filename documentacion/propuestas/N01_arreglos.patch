+    assert bot._texto_router("resume esto") is None
+    assert pedidos == [{"solo_local": True}]
+
+
+# ---------------------------------------------------------------- router (H09, H11)
+
+def test_h09_router_no_lanza_si_qwen_esta_caido(monkeypatch):
+    import router
+    from extremidades import qwen
+
+    def caido(*a, **k):
+        raise ConnectionError("Connection refused (simulado)")
+
+    monkeypatch.setattr(qwen, "pedir", caido)
+    monkeypatch.setattr(router, "registrar_evidencia", lambda *a, **k: None)
+    r = router.procesar("Resume esto: el gato duerme en el sofa toda la tarde.")
+    assert r["estado"] == "ESCALADO" and r["categoria"] == "otro"
+
+
+def test_h11_solo_local_no_sale_a_gemini_ni_chatgpt(monkeypatch):
+    import router
+    from extremidades import qwen
+    from proveedores import Resultado
+
+    monkeypatch.setattr(router, "registrar_evidencia", lambda *a, **k: None)
+    monkeypatch.setattr(qwen, "clasificar", lambda *a, **k: "resumen")
+
+    class QwenFalla:
+        nombre = "qwen"
+
+        def enviar(self, prompt):
+            return Resultado("ERROR", detalle="fallo simulado")
+
+    def prohibido(*a, **k):
+        raise AssertionError("con solo_local no se construye ningun proveedor externo")
+
+    monkeypatch.setattr(router, "QwenProvider", QwenFalla)
+    for nombre in ("GeminiAPIProvider", "GeminiProvider", "ChatGPTProvider"):
+        monkeypatch.setattr(router, nombre, prohibido)
+    r = router.procesar("Resume esto: uno dos tres cuatro cinco seis.", solo_local=True)
+    assert r["estado"] == "ESCALADO" and "solo_local" in r["motivo"]
