+# ---------------------------------------------------------------- ComfyUI por PID exacto (H08)
+
+class _Res:
+    def __init__(self, salida="", codigo=0):
+        self.salida, self.codigo, self.error = salida, codigo, ""
+
+    @property
+    def ok(self):
+        return self.codigo == 0
+
+
+@pytest.fixture
+def imagen_aislada(monkeypatch, tmp_path):
+    from extremidades import imagen
+    monkeypatch.setattr(imagen, "PID_COMFY", tmp_path / "comfyui_pid.json")
+    ordenes = []
+    return imagen, ordenes, tmp_path
+
+
+def _con_linea(imagen, ordenes, monkeypatch, linea_real):
+    def ejecutar(comando, **k):
+        ordenes.append(comando)
+        return _Res(linea_real + "\r\n" if "CommandLine" in comando and linea_real else "")
+    monkeypatch.setattr(imagen, "ejecutar", ejecutar)
+
+
+def test_h08_sin_pid_anotado_no_se_mata_nada(imagen_aislada, monkeypatch):
+    imagen, ordenes, _ = imagen_aislada
+    _con_linea(imagen, ordenes, monkeypatch, "cualquiera")
+    assert imagen._matar_comfyui() is False
+    assert ordenes == []
+
+
+def test_h08_solo_el_pid_anotado_y_con_la_misma_linea(imagen_aislada, monkeypatch):
+    imagen, ordenes, tmp = imagen_aislada
+    linea = subprocess.list2cmdline(imagen.ARRANQUE)
+    (tmp / "comfyui_pid.json").write_text(json.dumps({"pid": 4321, "linea": linea}))
+    _con_linea(imagen, ordenes, monkeypatch, linea)
+    assert imagen._matar_comfyui() is True
+    assert ordenes[-1] == "Stop-Process -Id 4321 -Force"
+    assert not any("-like" in o or "-Name" in o for o in ordenes)
+
+
+def test_h08_pid_reutilizado_por_otro_proceso_no_se_toca(imagen_aislada, monkeypatch):
+    imagen, ordenes, tmp = imagen_aislada
+    linea = subprocess.list2cmdline(imagen.ARRANQUE)
+    (tmp / "comfyui_pid.json").write_text(json.dumps({"pid": 4321, "linea": linea}))
+    _con_linea(imagen, ordenes, monkeypatch, "C:\\Windows\\notepad.exe")
+    assert imagen._matar_comfyui() is False
+    assert not any(o.startswith("Stop-Process") for o in ordenes)
+
+
+def test_h08_el_comando_de_matar_es_verde():
+    from nucleo.permisos import Nivel, nivel_de_comando
+    assert nivel_de_comando("Stop-Process -Id 4321 -Force") is Nivel.VERDE
